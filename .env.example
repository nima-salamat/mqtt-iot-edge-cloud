# Docker registry host only (no https:// and no trailing slash).
# Examples: docker.io, mirror.gcr.io, registry.example.com:5000
# For a private registry, run: docker login "$DOCKER_REGISTRY" before deployment.
DOCKER_REGISTRY=docker.io
IMAGE_TAG=latest
# Optional full image overrides for mirrors with different paths/tags.
# Leave empty to follow DOCKER_REGISTRY. Mosquitto defaults to the official 2.1.4-alpine tag.
MOSQUITTO_IMAGE=
MEDIAMTX_IMAGE=

# Host Nginx terminates HTTPS; the application services run in Docker Compose.
DOMAIN=server.echonode.website
PROXY_MODE=compose-nginx

# sqlite is convenient for a first, single-server test. Use postgres for production.
DATABASE_MODE=sqlite
DATABASE_PATH=/app/data/db.sqlite3
POSTGRES_DB=iotlab
POSTGRES_USER=iotlab
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD

DJANGO_SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=server.echonode.website,localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=https://server.echonode.website

# Host Nginx and MediaMTX use the dedicated Certbot certificate.
# Mount the whole /etc/letsencrypt directory so live/ symlinks can resolve
# their archive/ targets inside the MediaMTX container.
HOST_CERT_DIR=/etc/letsencrypt
MEDIA_TLS_CERT=/host-certs/live/server.echonode.website/fullchain.pem
MEDIA_TLS_KEY=/host-certs/live/server.echonode.website/privkey.pem

# Local-only published ports consumed by host Nginx.
API_BIND_PORT=18000
OPS_BIND_PORT=18501
MQTT_WS_BIND_PORT=19001

# Internal operator diagnostics login at /ops. Normal user dashboard is Django.
PANEL_USERNAME=operator
PANEL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PANEL_PASSWORD

# MQTT identities. camera-edge can publish notifications only.
MQTT_TOPIC_PREFIX=iotlab
MQTT_WS_PATH=/mqtt
MQTT_CAMERA_EDGE_USERNAME=camera-edge
MQTT_CAMERA_EDGE_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_CAMERA_EDGE_PASSWORD
MQTT_SERVER_USERNAME=django-server
MQTT_SERVER_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SERVER_PASSWORD

RTSPS_HOST=server.echonode.website
RTSPS_PORT=8322
MEDIA_ROOT=/app/data/media

# Legacy Swarm/Traefik settings are not used by PROXY_MODE=compose-nginx.
STACK_NAME=mqtt-iot
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_CERT_RESOLVER=letsencrypt
