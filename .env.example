# VPS public hostname
DOMAIN=server.echonode.website

# traefik-swarm = existing Traefik Swarm provider; traefik-compose = Docker provider; standalone = bundled Caddy.
PROXY_MODE=traefik-swarm
STACK_NAME=mqtt-iot
MQTT_IOT_IMAGE=mqtt-iot-edge-cloud:local
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_CERT_RESOLVER=letsencrypt

# Django data layer
DJANGO_SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=server.echonode.website,localhost,127.0.0.1

# Streamlit panel account (separate from the Raspberry Pi local login)
PANEL_USERNAME=operator
PANEL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PANEL_PASSWORD

# MQTT identities. The credentials below are stored as hashes by Mosquitto.
MQTT_DEVICE_USERNAME=raspberry-pi-01
MQTT_DEVICE_PASSWORD=REPLACE_WITH_DEVICE_PASSWORD
MQTT_SERVER_USERNAME=django-server
MQTT_SERVER_PASSWORD=REPLACE_WITH_SERVER_PASSWORD

MQTT_TOPIC_PREFIX=iotlab
MQTT_WS_PATH=/mqtt
