# Raspberry Pi 4 alarm camera agent.
DOMAIN=server.echonode.website
API_BASE_URL=https://server.echonode.website

# This MQTT identity is permitted to publish alarm notifications only.
MQTT_HOST=server.echonode.website
MQTT_PORT=443
MQTT_WS_PATH=/mqtt
MQTT_TLS=1
MQTT_TOPIC_PREFIX=iotlab
MQTT_USERNAME=camera-edge
MQTT_PASSWORD=REPLACE_WITH_MQTT_CAMERA_EDGE_PASSWORD

# Leave DEVICE_ID empty to generate a persistent unique ID on first run.
DEVICE_ID=
DEVICE_NAME=Front Door Camera
DEVICE_CREDENTIALS_PATH=/var/lib/mqttiot/device.json
PI_DATA_DIR=/var/lib/mqttiot
PI_SETTINGS_PATH=/var/lib/mqttiot/settings.json
MODEL_DIR=/opt/mqtt-iot-edge-cloud/pi_device/models

RTSPS_HOST=server.echonode.website
RTSPS_PORT=8322

# LAN-only local management portal.
LOCAL_WEB_PASSWORD=REPLACE_WITH_A_LONG_LOCAL_PASSWORD
FLASK_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
LOCAL_WEB_HOST=0.0.0.0
LOCAL_WEB_PORT=8080

VIDEO_FPS=30
VIDEO_BITRATE=4000000
VIDEO_SEGMENT_SECONDS=5
INFERENCE_FPS=5
ALERT_CONFIDENCE=0.45
ALERT_COOLDOWN_SECONDS=15
ALERT_CLEAR_SECONDS=4

LOCAL_VIDEO_RETENTION_MINUTES=10
UPLOAD_QUEUE_RETENTION_HOURS=72
UPLOAD_QUEUE_MAX_GB=8
LOCAL_ALARM_RETENTION_DAYS=7
LOCAL_LOG_RETENTION_DAYS=7
LOG_LEVEL=INFO
