# Edge devices share a broker username with wildcard topic-level access.
# Every remote command is AES-GCM encrypted with a per-device derived key and
# HMAC-signed; other cameras can see routing metadata but cannot read contents.
user camera-edge
topic write iotlab/devices/+/alarms
topic write iotlab/devices/+/telemetry
topic write iotlab/devices/+/status
topic read iotlab/devices/+/commands
topic write iotlab/devices/+/command-acks

# Django consumes signed device events and publishes signed remote commands.
user django-server
topic read iotlab/devices/+/alarms
topic read iotlab/devices/+/telemetry
topic read iotlab/devices/+/status
topic write iotlab/devices/+/commands
topic read iotlab/devices/+/command-acks
topic read $SYS/#
