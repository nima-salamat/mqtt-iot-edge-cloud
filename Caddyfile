{$DOMAIN} {
    encode zstd gzip

    @mediamtxAuth path /api/mediamtx/auth*
    handle @mediamtxAuth {
        respond 404
    }

    @mqtt path /mqtt*
    handle @mqtt {
        reverse_proxy broker:9001
    }

    @ops path /ops*
    handle @ops {
        reverse_proxy web:8501
    }

    @webrtc path /webrtc/*
    handle @webrtc {
        uri strip_prefix /webrtc
        reverse_proxy mediamtx:8889
    }

    @streams path /streams/*
    handle @streams {
        uri strip_prefix /streams
        reverse_proxy mediamtx:8888
    }

    handle {
        reverse_proxy api:8000
    }
}
