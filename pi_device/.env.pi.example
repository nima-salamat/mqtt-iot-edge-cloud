# Copy this to /etc/mqtt-iot-pi.env on Raspberry Pi 4.
MQTT_HOST=server.echonode.website
MQTT_PORT=443
MQTT_WS_PATH=/mqtt
MQTT_TLS=1
MQTT_TOPIC_PREFIX=iotlab
MQTT_USERNAME=raspberry-pi-01
MQTT_PASSWORD=REPLACE_WITH_THE_SAME_DEVICE_PASSWORD_SET_ON_VPS
DEVICE_ID=raspberry-pi-01

# Protect the local web page with a separate password.
LOCAL_WEB_PASSWORD=REPLACE_WITH_A_LONG_LOCAL_PASSWORD
FLASK_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
LOCAL_WEB_HOST=0.0.0.0
LOCAL_WEB_PORT=8080

# Set to 1 only after connecting a low-voltage LED + resistor to BCM GPIO17.
ENABLE_GPIO=0
GPIO_PIN=17
