[Unit]
Description=MQTT IoT local web panel and device client (Raspberry Pi 4)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mqttiot
Group=mqttiot
WorkingDirectory=/opt/mqtt-iot-edge-cloud
EnvironmentFile=/etc/mqtt-iot-pi.env
ExecStart=/opt/mqtt-iot-edge-cloud/.venv/bin/python -m pi_device.app
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
